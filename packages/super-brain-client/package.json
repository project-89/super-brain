{
  "name": "@_89/super-brain-client",
  "version": "0.0.0",
  "description": "Harness-neutral HTTP and event-stream client for Super Brain",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_89/fold": "workspace:*",
    "@_89/fold-epistemic": "workspace:*",
    "@_89/fold-sdk": "workspace:*",
    "@_89/fold-transcript": "workspace:*",
    "@_89/fold-trajectory": "workspace:*"
  }
}
