{
  "name": "@_89/fold-storage",
  "version": "0.0.0",
  "description": "Versioned JSONL persistence, replay, and checkpoints for Fold logs",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "PROVENANCE.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_89/fold": "workspace:*",
    "zod": "^3.25.0"
  }
}
