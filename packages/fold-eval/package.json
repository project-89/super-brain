{
  "name": "@_89/fold-eval",
  "version": "0.0.0",
  "description": "Standalone verdict parsing and verification oracle execution for Fold",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "PROVENANCE.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/retrieval-main.ts --format esm",
    "retrieval": "node dist/retrieval-main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_89/confidence-kernel": "workspace:*"
  }
}
