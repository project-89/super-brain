{
  "name": "@_89/super-brain-mcp-server",
  "version": "0.0.0",
  "description": "Harness-neutral MCP access to Super Brain recall, reasoning, capture, and feedback",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "super-brain-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_89/super-brain-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0",
    "@_89/super-brain-importer": "workspace:*"
  }
}
