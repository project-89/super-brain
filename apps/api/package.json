{
  "name": "@_89/super-brain-api",
  "version": "0.0.0",
  "description": "Authenticated HTTP API for scoped Fold records and personal memory",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_89/fold": "workspace:*",
    "@_89/fold-epistemic": "workspace:*",
    "@_89/fold-sdk": "workspace:*",
    "@_89/fold-storage": "workspace:*",
    "zod": "^3.25.0"
  }
}
