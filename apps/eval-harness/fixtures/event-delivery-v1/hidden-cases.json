[
  {
    "id": "empty-initial",
    "group": "continuation",
    "description": "An empty initial batch preserves zero.",
    "inputJson": "{\"state\":{\"checkpoint\":\"0\",\"events\":[]},\"arrivals\":[]}",
    "expected": {
      "kind": "return",
      "value": {
        "checkpoint": "0",
        "events": []
      }
    }
  },
  {
    "id": "empty-canonical-order",
    "group": "ordering",
    "description": "An empty batch still orders retained events by time then ordinary ID.",
    "inputJson": "{\"state\":{\"checkpoint\":\"8\",\"events\":[{\"id\":\"C\",\"t\":20,\"payload\":{\"v\":3}},{\"id\":\"A\",\"t\":20,\"payload\":{\"nested\":{\"x\":1,\"y\":[true,null,\"text\"]}}},{\"id\":\"B\",\"t\":5,\"payload\":{\"v\":2}}]},\"arrivals\":[]}",
    "expected": {
      "kind": "return",
      "value": {
        "checkpoint": "8",
        "events": [
          {
            "id": "B",
            "t": 5,
            "payload": {
              "v": 2
            }
          },
          {
            "id": "A",
            "t": 20,
            "payload": {
              "nested": {
                "x": 1,
                "y": [
                  true,
                  null,
                  "text"
                ]
              }
            }
          },
          {
            "id": "C",
            "t": 20,
            "payload": {
              "v": 3
            }
          }
        ]
      }
    }
  },
