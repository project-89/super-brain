  {
    "id": "equal-payload-distinct-ids",
    "group": "identity",
    "description": "Equal payload and time do not collapse distinct IDs.",
    "inputJson": "{\"state\":{\"checkpoint\":\"0\",\"events\":[]},\"arrivals\":[{\"sequence\":\"1\",\"event\":{\"id\":\"different-id\",\"t\":20,\"payload\":{\"nested\":{\"x\":1,\"y\":[true,null,\"text\"]}}}},{\"sequence\":\"2\",\"event\":{\"id\":\"A\",\"t\":20,\"payload\":{\"nested\":{\"x\":1,\"y\":[true,null,\"text\"]}}}}]}",
    "expected": {
      "kind": "return",
      "value": {
        "checkpoint": "2",
        "events": [
          {
            "id": "A",
            "t": 20,
            "payload": {
              "nested": {
                "x": 1,
                "y": [
                  true,
                  null,
                  "text"
                ]
              }
            }
          },
          {
            "id": "different-id",
            "t": 20,
            "payload": {
              "nested": {
                "x": 1,
                "y": [
                  true,
                  null,
                  "text"
                ]
              }
            }
          }
        ]
      }
    }
  },
