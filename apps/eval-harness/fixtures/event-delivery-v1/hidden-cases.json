    "expected": {
      "kind": "return",
      "value": {
        "checkpoint": "2",
        "events": [
          {
            "id": "array",
            "t": 1,
            "payload": [
              {
                "b": 2,
                "a": 1
              },
              [
                null,
                false
              ],
              3
            ]
          }
        ]
      }
    }
  },
