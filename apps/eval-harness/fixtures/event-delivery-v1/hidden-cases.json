    "expected": {
      "kind": "return",
      "value": {
        "checkpoint": "42",
        "events": [
          {
            "id": "A",
            "t": 20,
            "payload": {
              "nested": {
                "x": 1,
                "y": [
                  true,
                  null,
                  "text"
                ]
              }
            }
          }
        ]
      }
    }
