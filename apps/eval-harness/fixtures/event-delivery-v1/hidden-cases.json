                "x": 1,
                "y": [
                  true,
                  null,
                  "text"
                ]
              }
            }
          }
        ]
      }
    }
  },
  {
    "id": "array-exact-retry",
    "group": "json-equality",
    "description": "Arrays preserve element order while nested object key order is irrelevant.",
