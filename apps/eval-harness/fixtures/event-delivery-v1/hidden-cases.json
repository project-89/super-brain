            "t": 0,
            "payload": null
          },
          {
            "id": "p1",
            "t": 1,
            "payload": false
          },
          {
            "id": "p2",
            "t": 2,
            "payload": true
          },
          {
            "id": "p3",
            "t": 3,
            "payload": 0
          },
          {
            "id": "p4",
            "t": 4,
            "payload": -1
          },
          {
            "id": "p5",
            "t": 5,
