{
  "name": "@_89/super-brain-eval-harness",
  "version": "0.0.0",
  "description": "Frozen synthetic two-provider evaluation with isolated executable checks",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "super-brain-eval": "./dist/main.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_89/fold": "workspace:*",
    "@_89/fold-eval": "workspace:*",
    "@_89/fold-sdk": "workspace:*",
    "@_89/fold-trace": "workspace:*",
    "@_89/fold-trajectory": "workspace:*",
    "@_89/super-brain-api": "workspace:*",
    "@_89/super-brain-client": "workspace:*"
  }
}
